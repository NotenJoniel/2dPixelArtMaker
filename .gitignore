# OS / Editor generated files
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Python cache
__pycache__/
*.py[cod]
.venv/
venv/

# Workspace intermediate & preview outputs (regenerable from workspace/01_raw/*.py)
# Note: workspace/01_raw/ generator scripts (*.py, *.json, *.md) are tracked in Git!
workspace/01_raw/**/*.png
workspace/01_raw/**/*.jpg
workspace/01_raw/**/*.webp
workspace/02_work/*
!workspace/02_work/.gitkeep
workspace/03_preview/*
!workspace/03_preview/.gitkeep
